# =============================================================================
# MangaDich — Environment Variables
# Copy file này thành backend/.env và điền giá trị thực
# =============================================================================

# Google Gemini API Key (dùng cho dịch manga)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (mặc định SQLite — không cần thay đổi)
DATABASE_URL=sqlite:///./mangadich_v2.db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
